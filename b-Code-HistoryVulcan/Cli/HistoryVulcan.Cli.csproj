<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>HistoryVulcan.Cli</RootNamespace>
    <AssemblyName>HistoryVulcan.Cli</AssemblyName>
    <Product>HistoryVulcan</Product>
    <Title>HistoryVulcan</Title>
    <AssemblyTitle>HistoryVulcan</AssemblyTitle>
    <Description>Console CLI for the HistoryVulcan host.</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!--
      probe 在本进程里装载模块。界面模块要 PresentationFramework，
      而模块带不走这份共享框架；与服务进程一样只加框架引用，不开 UseWPF。
    -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <ProjectReference Include="..\HistoryVulcan.ServiceHost\HistoryVulcan.ServiceHost.csproj" />
  </ItemGroup>
</Project>
