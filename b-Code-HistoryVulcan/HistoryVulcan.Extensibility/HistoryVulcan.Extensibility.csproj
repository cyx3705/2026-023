<Project Sdk="Microsoft.NET.Sdk">

  <!--
    演进层。与 HistoryVulcan.Core 的区别不是功能领域，而是**稳定性承诺**：

    Core 是地基——全体模块都要用、且一年后仍然成立的契约。它带冻结标签、公开 API 基线
    与严格门禁，公开面只许降不许升。

    本程序集相反：它装的是少数模块需要的、注定要随交互形态迭代的类型化契约。这类东西
    留在 Core 会把两头都拖坏——扩展面的正常演进被迫触发地基的版本事件，而地基的冻结
    承诺又让扩展面每次改动都昂贵。3.5.0 的 120 行新增公开面里约 90 行只服务于单一模块，
    正是这个混装的症状。

    因此本项目**刻意不引用 PublicApiAnalyzer**：没有 API 基线、不进冻结门禁，可以跟着
    模块需要自由演进。要往这里加东西的判据很简单——凡是能用命令名表达的联动都该走
    命令总线（见 CommandBus.InvokeAsync），只有真正无法用名字表达的（有状态交互会话、
    需要传递活对象）才配拥有类型，而这些类型的家在这里，不在 Core。
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HistoryVulcan.Extensibility</RootNamespace>
    <PackageId>OneHistory.HistoryVulcan.Extensibility</PackageId>
    <Title>OneHistory HistoryVulcan Extensibility</Title>
    <Description>Evolving typed extension contracts for OneHistory HistoryVulcan modules. Not covered by the Core freeze gate.</Description>
    <PackageTags>onehistory;HistoryVulcan;extensibility</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <!-- 刻意不引 Microsoft.CodeAnalysis.PublicApiAnalyzers：本层不承诺公开面冻结。 -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HistoryVulcan.Core\HistoryVulcan.Core.csproj" />
  </ItemGroup>

</Project>
